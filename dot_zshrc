# Case insensitive tab complete
# see https://stackoverflow.com/a/24237590
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
autoload -Uz compinit && compinit

path+=~/bin
path+=~/.cargo/bin
path+=~/.dotnet/tools

alias fd="fd --no-ignore"

# Windows CLI compat
dir() {
  ls "$@"
}

cls() {
  clear
}

md() {
  mkdir -p "$@"
}

rd() {
  local rm_args=""
  local target_paths=()
  for arg in "$@"; do
    case $arg in
      /s)   rm_args="$rm_args -r" ;;
      /q)   rm_args="$rm_args -f" ;;
      /s/q) rm_args="-rf" ;;
      *)    target_paths+=("$arg") ;;
    esac
  done
  echo "rm $rm_args ${target_paths[@]}"
  rm ${=rm_args} "${target_paths[@]}"
}

export MSBUILDFORCEMULTITHREADED=1

if [[ -x "$HOME/.dotnetup/dotnetup" ]]; then
    eval "$("$HOME/.dotnetup/dotnetup" env script --shell zsh --dotnet --dotnetup)"
else
    echo "dotnetup not installed -- curl -fsSL https://aka.ms/dotnet/dotnetup/preview/get-dotnetup.sh | bash"
fi

# Run completions script outside of any working directory
# that may have a global.json that keeps things cranky
() {
  local PWD tempdir script
  local temp_root=${XDG_RUNTIME_DIR:-$TMPDIR}

  [[ -n $temp_root && -d $temp_root && -O $temp_root ]] || return 1
  tempdir=$(command mktemp -d "${temp_root%/}/dotnet-completions.XXXXXXXX") || return

  {
    builtin cd -q -- "$tempdir" || return
    script=$(dotnet completions script zsh) || return
    eval "$script"
  } always {
    command rm -rf -- "$tempdir"
  }
}

eval "$(starship init zsh)"

eval "$(atuin init zsh --disable-up-arrow)"

eval "$(zoxide init zsh)"
