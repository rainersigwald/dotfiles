# Case insensitive tab complete
# see https://stackoverflow.com/a/24237590
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
autoload -Uz compinit && compinit

path+=~/bin
path+=~/.cargo/bin
path+=~/.dotnet/tools

alias fd="fd --no-ignore"

if [[ -x "$HOME/.dotnetup/dotnetup" ]]; then
    eval "$("$HOME/.dotnetup/dotnetup" env script --shell zsh --dotnet --dotnetup)"
else
    echo "dotnetup not installed -- curl -fsSL https://aka.ms/dotnet/dotnetup/preview/get-dotnetup.sh | bash"
fi

eval "$(starship init zsh)"

eval "$(atuin init zsh --disable-up-arrow)"

eval "$(zoxide init zsh)"
