{{ if eq .chezmoi.os "windows" -}}

setlocal
rem configuration: {{ include "Windows/configuration.winget" | sha256sum }}

winget.exe configure --file "{{ joinPath .chezmoi.sourceDir "Windows" "configuration.winget" }}" --accept-configuration-agreements --disable-interactivity
if not "%errorlevel%"=="0" exit /b %errorlevel%

powershell.exe -NoProfile -Command "$ErrorActionPreference = 'Stop'; $env:PATH = [Environment]::GetEnvironmentVariable('PATH', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('PATH', 'User') + ';' + $env:PATH; az extension add --name azure-devops; exit $LASTEXITCODE"
exit /b %errorlevel%

{{ end -}}
